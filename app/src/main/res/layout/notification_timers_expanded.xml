<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/timer_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:paddingBottom="8dp" style="@style/TextAppearance.Compat.Notification.Title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/notification_library" style="@style/TextAppearance.Compat.Notification" />
        <Chronometer android:id="@+id/library_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="18sp" android:fontFamily="monospace" style="@style/TextAppearance.Compat.Notification.Title" />
        <TextView android:id="@+id/library_frozen" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="18sp" android:fontFamily="monospace" style="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/notification_study" style="@style/TextAppearance.Compat.Notification" />
        <Chronometer android:id="@+id/study_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="18sp" android:fontFamily="monospace" style="@style/TextAppearance.Compat.Notification.Title" />
        <TextView android:id="@+id/study_frozen" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="18sp" android:fontFamily="monospace" style="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>
</LinearLayout>
